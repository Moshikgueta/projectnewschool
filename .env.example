# New School Learning Platform — environment variables
#
# Copy to .env.local for local development and fill in values.
# NEVER commit real values. .env*.local is git-ignored.
# Staging/production values live in Vercel (per environment) and GitHub Actions secrets.
#
# Rule: only variables prefixed NEXT_PUBLIC_ reach the browser, and only values that are
# safe to publish may use that prefix. Full table: docs/DEPLOYMENT.md §4.

# ── App ────────────────────────────────────────────────────────────────────────
# local | preview | staging | production
APP_ENV=local
# Absolute base URL, used in auth emails and redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────────────────────
# Local values are printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key: safe in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET. Server only. Bypasses RLS. Used exclusively by src/server/privileged/.
SUPABASE_SECRET_KEY=

# ── Error monitoring (optional locally) ────────────────────────────────────────
SENTRY_DSN=

# ── CI only — do not set locally ───────────────────────────────────────────────
# SENTRY_AUTH_TOKEN=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF_STAGING=
# SUPABASE_PROJECT_REF_PRODUCTION=
# SUPABASE_DB_PASSWORD_STAGING=
# SUPABASE_DB_PASSWORD_PRODUCTION=
# BACKUP_BUCKET_URL=
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_KEY=

# Email (SMTP via Resend) is configured in the Supabase dashboard (Auth → SMTP),
# not here.
