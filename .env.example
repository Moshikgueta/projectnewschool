# Server settings, with dummy values. Copy to .dev.vars for `wrangler dev`;
# in production set them as Secrets (Worker → Settings → Variables and Secrets).
#
# There is no SESSION_SECRET here: staff sessions are rows in D1, not signed
# cookies, so there is no signing key to keep.

RESEND_API_KEY=re_dummy_key          # optional — without it no reset emails are sent (nothing breaks)
EMAIL_FROM=teacherroom@example.com   # optional — verified sender for the reset link

# Set ONLY while creating the very first admin account, then delete it.
# The bootstrap endpoint refuses to run once any account exists, so a forgotten
# value is not a standing door — but delete it anyway.
STAFF_BOOTSTRAP_TOKEN=
